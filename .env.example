# =============================================================================
# Consulta Viva — variáveis de ambiente
#
# Copie para `.env` e preencha. O `.env` está no .gitignore e NUNCA deve ser
# commitado: ele contém chaves que dão acesso a dados de saúde.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Desenvolvimento local (pnpm db:up). Porta 5433 de propósito: evita
# conflito com um PostgreSQL já instalado na máquina usando a 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/scribe"

# Produção — Supabase, região São Paulo (sa-east-1).
# Use a connection string do "Session pooler" para o worker (conexões longas)
# e a do "Transaction pooler" para a aplicação web (serverless).
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase — Auth e Storage
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ⚠️ Ignora TODAS as políticas RLS. Só no worker, nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# Bucket privado do áudio das consultas
SUPABASE_AUDIO_BUCKET="session-audio"

# -----------------------------------------------------------------------------
# Motores de transcrição
#
# local — Whisper + pyannote em services/asr-local. Motor do plano grátis.
#         O áudio nunca sai do container. Custo marginal ~zero, mais lento.
# cloud — API comercial. Fornecedor decidido no Marco 1 (ADR-0002, pendente).
#
# Quem recebe qual motor é decidido em packages/core/src/account.ts:
#   plano free            → local
#   plano pro/clinic      → cloud
#   cargo developer       → escolhe (é a razão de o cargo existir)
# -----------------------------------------------------------------------------
ASR_LOCAL_URL="http://localhost:8001"

# Raiz do armazenamento de audio, relativa a raiz do monorepo.
# A web escreve, o worker le: precisa ser a mesma pasta nos dois.
STORAGE_ROOT=".storage"

# Modelo do Whisper: tiny | base | small | medium | large-v3
# `medium` equilibra qualidade e velocidade em CPU.
# Para o spike do Marco 1, que decide o fornecedor, use `large-v3`.
WHISPER_MODEL="medium"
WHISPER_COMPUTE_TYPE="int8"
WHISPER_LANGUAGE="pt"

# Diarização (separar vozes) exige aceitar os termos de
# pyannote/speaker-diarization-3.1 no Hugging Face e gerar um token gratuito
# em https://huggingface.co/settings/tokens
# Sem token o serviço sobe e transcreve, mas não separa as vozes.
HF_TOKEN=""

# -----------------------------------------------------------------------------
# LLM — geração da nota clínica
#
# Gratuito para desenvolver: https://aistudio.google.com/apikey — sem cartão.
# Rode `pnpm llm:models` para ver quais modelos a sua chave acessa.
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=""
LLM_MODEL="gemini-2.5-flash"

# O piso de tratamento de dados que ESTE ambiente aceita.
#
#   contractual — só fornecedor com termos de não-treinamento. É o PADRÃO,
#                 e é o único valor aceitável com paciente real.
#   training    — aceita também o nível gratuito, que registra os prompts e
#                 treina com eles. Só para desenvolvimento com áudio simulado.
#
# O padrão é o seguro de propósito: um ambiente novo nasce recusando o nível
# gratuito. Usar o grátis exige dizer isso em voz alta, aqui.
#
# ⚠️  Transcrição de consulta é dado sensível de saúde (LGPD Art. 11).
#     Mandá-la para um fornecedor que treina com ela é uso secundário sem base
#     legal — a §10 da documentação exige consentimento específico, que
#     ninguém coleta.
LLM_DATA_POLICY="contractual"

# Caminho pago, quando houver paciente real. Vertex AI (região southamerica-east1)
# roda os mesmos modelos Gemini sob termos contratuais e com dados no Brasil.
# ANTHROPIC_API_KEY=""

# Segunda passada barata: confere se o trecho citado SUSTENTA a afirmação.
# Ainda não implementado — a conferência determinística vem primeiro.
# LLM_VERIFIER_MODEL=""

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="debug"

# Worker
WORKER_POLL_INTERVAL_MS="2000"
WORKER_CONCURRENCY="2"
WORKER_MAX_ATTEMPTS="3"

# Retenção de áudio em dias (LGPD — minimização). 0 = apagar após processar.
AUDIO_RETENTION_DAYS="30"

# Quota do plano grátis (ver §11 do PLANO-DE-DESENVOLVIMENTO.md)
FREE_PLAN_MINUTES_PER_MONTH="300"
