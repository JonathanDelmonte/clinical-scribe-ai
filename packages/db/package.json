{
  "name": "@scribe/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schema, migrations e políticas RLS",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "test:rls": "node --env-file-if-exists=../../.env src/test-rls.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "seed:demo": "node --env-file-if-exists=../../.env --import tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@scribe/auth": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13"
  }
}
